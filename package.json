{
  "name": "antiparos-rentacar-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape": "python3 scripts/scrape-all.py",
    "media": "python3 scripts/download-media.py",
    "registry": "python3 scripts/build-pages-registry.py",
    "parity": "python3 scripts/parity-check.py",
    "content": "npm run registry && npm run media",
    "fleet:fetch": "tsx scripts/fleet/fetch-gocars.ts",
    "fleet:normalize": "tsx scripts/fleet/normalize.ts",
    "fleet:sync": "npm run fleet:fetch && npm run fleet:normalize",
    "routes:build": "tsx scripts/build-route-manifest.ts",
    "content:registry": "tsx scripts/build-content-registry.ts",
    "content:scaffold": "tsx scripts/scaffold-content.ts",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "validate:messages": "tsx scripts/validate-messages.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:seo": "tsx scripts/validate-seo-meta.ts",
    "validate": "npm run validate:routes; npm run validate:content; npm run validate:messages; npm run validate:seo",
    "prebuild": "npm run routes:build && npm run validate:routes && npm run validate:content && npm run validate:seo",
    "fleet:images": "tsx scripts/media/normalize-fleet.ts",
    "fleet:pexels": "tsx scripts/media/fetch-pexels.ts",
    "reviews:normalize": "tsx scripts/reviews/normalize.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
